#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>categories</code>: dict containing the computed salary rule categories"
" (sum of amount of all rules belonging to that category)."
msgstr ""
"<code>categories</code>: دیکشنری حاوی دسته‌بندی‌های محاسبه‌شده قوانین حقوق و"
" دستمزد (مجموع مبلغ تمام قوانین متعلق به آن دسته)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>employee</code>: hr.employee object"
msgstr "<code>employee</code>: شیء کارمند (hr.employee)"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>inputs</code>: dict containing the computed inputs."
msgstr "<code>inputs</code>: دیکشنری حاوی مقادیر ورودی محاسبه‌شده."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>payslip</code>: hr.payslip object"
msgstr "<code>payslip</code>: شیء فیش حقوقی (hr.payslip)"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result</code>: boolean True if the rule should be calculated, False "
"otherwise"
msgstr ""
"<code>result</code>: مقدار بولین True اگر قانون باید محاسبه شود، در غیر این "
"صورت False"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result</code>: float, base amount of the rule"
msgstr "<code>result</code>: عدد اعشاری (float)، مبلغ پایه قانون"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_name</code>: string, name of the line, which defaults to the "
"name field of the salary rule (useful if the name depends or should depend "
"on something computed in the rule)."
msgstr ""
"<code>result_name</code>: رشته متنی، نام سطر که به صورت پیش‌فرض فیلد نام "
"قانون حقوق و دستمزد است (مفید اگر نام به مقدار محاسبه‌شده‌ای در قانون وابسته"
" باشد یا باید باشد)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result_qty</code>: float, quantity, which defaults to 1."
msgstr ""
"<code>result_qty</code>: عدد اعشاری (float)، تعداد، که به طور پیش‌فرض ۱ است."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_rate</code>: float, rate between -100.0 and 100.0, which "
"defaults to 100.0 (%)."
msgstr ""
"<code>result_rate</code>: عدد اعشاری (float)، نرخ بین -۱۰۰.۰ و ۱۰۰.۰، که به "
"طور پیش‌فرض ۱۰۰.۰ (٪) است."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_rules</code>: dict containing the rules amounts, quantities, "
"rates and totals (previously computed)"
msgstr ""
"<code>result_rules</code>: دیکشنری حاوی مبالغ، تعداد، نرخ‌ها و مجموع‌های "
"قوانین (محاسبه‌شده در قبل)"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>total = result * result_rate / 100 * result_qty</code>"
msgstr "<code>total = result * result_rate / 100 * result_qty</code>"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>version</code>: hr.version object"
msgstr "<code>version</code>: شیء نسخه (hr.version)"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>worked_days</code>: dict containing the computed worked days"
msgstr "<code>worked_days</code>: دیکشنری حاوی روزهای کارکرد محاسبه‌شده"

