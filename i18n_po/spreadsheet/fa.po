msgstr "نرخ حدس‌زده‌شده (%s) باید اکیداً بزرگ‌تر از ۱- باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The redemption (%s) must be strictly positive."
msgstr "مبلغ بازخرید (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
