#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be different from -1."
msgstr "تخفیف (%s) باید مقداری غیر از -1 باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be smaller than 1."
msgstr "تخفیف (%s) باید کمتر از 1 باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be strictly positive."
msgstr "تخفیف (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the bill at time of purchase."
msgstr "نرخ تنزیل برات در زمان خرید."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the investment over one period."
msgstr "نرخ تنزیل سرمایه‌گذاری در طول یک دوره."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the security at time of purchase."
msgstr "نرخ تنزیل اوراق بهادار در زمان خرید."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the security invested in."
msgstr "نرخ تنزیل اوراق بهاداری که در آن سرمایه‌گذاری شده است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The divisor must be different from 0."
msgstr "مقسوم‌علیه باید غیر از 0 باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The divisor must be different from zero."
msgstr "مقسوم‌علیه باید غیر از صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The effective interest rate per year."
msgstr "نرخ بهره مؤثر سالانه."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The effective_rate (%s) must be strictly positive."
msgstr "نرخ مؤثر (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date of the period from which to calculate the number of net working"
" days."
msgstr ""
"تاریخ پایان دوره‌ای که برای محاسبه تعداد روزهای کاری خالص استفاده می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end date to consider in the calculation."
msgstr "تاریخ پایانی که باید در محاسبه لحاظ شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date to consider in the calculation. Must be a reference to a cell "
"containing a DATE, a function returning a DATE type, or a number."
msgstr ""
"تاریخ پایان برای لحاظ در محاسبه. باید ارجاع به سلولی با تاریخ (DATE)، تابعی "
"با خروجی نوع تاریخ یا یک عدد باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date to consider in the calculation. Must be a reference to a cell "
"containing a date, a function returning a date type, or a number."
msgstr ""
"تاریخ پایان برای لحاظ در محاسبه. باید ارجاع به سلول حاوی تاریخ، تابعی با "
"خروجی تاریخ یا یک عدد باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end of the date range."
msgstr "پایان بازه تاریخی."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end_date (%s) must be positive or null."
msgstr "تاریخ پایان (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end_period (%(end)s) must be smaller or equal to the life (%(life)s)."
msgstr "دوره پایان (%(end)s) باید کوچک‌تر یا مساوی عمر مفید (%(life)s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end_period (%s) must be positive or null."
msgstr "دوره پایان (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The expected annual yield of the security."
msgstr "بازده سالانه مورد انتظار اوراق بهادار."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent (%s) must be an integer when the base is negative."
msgstr "وقتی پایه منفی است، توان (%s) باید عدد صحیح باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent to raise base to."
msgstr "توانی که پایه باید به آن برسد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent to raise e."
msgstr "توانی که e باید به آن برسد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The extract_length argument (%s) must be positive or null."
msgstr "آرگومان طول استخراج (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The factor (%s) must be positive when the value (%s) is positive."
msgstr "زمانی که مقدار (%s) مثبت است، ضریب (%s) نیز باید مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The factor by which depreciation decreases."
msgstr "نرخ یا ضریبی که استهلاک با آن کاهش می‌یابد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/list/list_data_source.js:0
msgid "The field %s does not exist or you do not have access to that field"
msgstr "فیلد %s وجود ندارد یا شما به این فیلد دسترسی ندارید"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The field (%(fieldValue)s) must be one of %(dimRowDB)s or must be a number "
"between 1 and %s inclusive."
msgstr ""
"فیلد (%(fieldValue)s) باید یکی از موارد %(dimRowDB)s یا عددی بین 1 تا %s "
"(شامل هر دو) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The field (%s) must be one of %s."
msgstr "فیلد (%s) باید یکی از موارد %s باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The field must be a number or a string"
msgstr "فیلد باید عدد یا رشته باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/list/list_functions.js:0
msgid "The field name should not be empty."
msgstr "نام فیلد نباید خالی باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The file you are trying to copy is too large (>%sMB).\n"
"It will not be added to your OS clipboard.\n"
"You can download it directly instead."
msgstr ""
"فایلی که سعی در کپی آن دارید بسیار حجیم است (>%s مگابایت).\n"
"این فایل به کلیپ‌بورد سیستم‌عامل اضافه نخواهد شد.\n"
"می‌توانید به جای آن، فایل را مستقیماً دانلود کنید."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first addend."
msgstr "اولین جزء جمع (مضاف‌الیه اول)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first and second arguments of [[FUNCTION_NAME]] must be non-empty "
"matrices."
msgstr ""
"آرگومان‌های اول و دوم تابع [[FUNCTION_NAME]] باید ماتریس‌های غیرخالی باشند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first case to be checked against expression."
msgstr "اولین شرط یا حالتی که در برابر عبارت مقایسه می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first column index of the columns to be returned."
msgstr "شاخص اولین ستون از ستون‌هایی که باید بازگردانده شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first condition to be evaluated. This can be a boolean, a number, an "
"array, or a reference to any of those."
msgstr ""
"اولین شرطی که باید ارزیابی شود؛ می‌تواند بولین، عدد، آرایه یا ارجاعی به هر "
"یک از این‌ها باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first future cash flow."
msgstr "اولین جریان نقدی آتی."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first matrix in the matrix multiplication operation."
msgstr "اولین ماتریس در عملیات ضرب ماتریس‌ها."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first multiplicand."
msgstr "اولین جزء ضرب (مضروب اول)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number in the sequence"
msgstr "اولین عدد در دنباله"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number or range to add together."
msgstr "اولین عدد یا محدوده‌ای که باید با هم جمع شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number or range to calculate for the product."
msgstr "اولین عدد یا محدوده‌ای که برای حاصل‌ضرب محاسبه می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number to compare."
msgstr "اولین عدد برای مقایسه."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first range to be appended."
msgstr "اولین محدوده‌ای که باید متصل/پیوست شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first range to flatten."
msgstr "اولین محدوده‌ای که باید هم‌سطح (تک‌بعدی) شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first range whose entries will be multiplied with corresponding entries "
"in the other ranges."
msgstr ""
"اولین محدوده‌ای که مقادیر آن در مقادیر متناظر سایر محدوده‌ها ضرب می‌شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first row index of the rows to be returned."
msgstr "شاخص اولین سطر از سطرهایی که باید بازگردانده شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first string to compare."
msgstr "اولین رشته برای مقایسه."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value must be a number"
msgstr "مقدار اول باید یک عدد باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range in which to count the number of blanks."
msgstr "اولین مقدار یا محدوده‌ای که تعداد سلول‌های خالی در آن شمارش می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range of the population."
msgstr "اولین مقدار یا محدوده مربوط به جامعه آماری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range of the sample."
msgstr "اولین مقدار یا محدوده مربوط به نمونه آماری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range to consider for uniqueness."
msgstr "اولین مقدار یا محدوده‌ای که باید برای یکتا بودن بررسی شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first value or range to consider when calculating the average value."
msgstr "اولین مقدار یا محدوده‌ای که برای محاسبه میانگین لحاظ می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first value or range to consider when calculating the maximum value."
msgstr ""
"اولین مقدار یا محدوده‌ای که هنگام محاسبه بیشترین مقدار در نظر گرفته می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first value or range to consider when calculating the median value."
msgstr "اولین مقدار یا محدوده‌ای که هنگام محاسبه مقدار میانه لحاظ می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first value or range to consider when calculating the minimum value."
msgstr ""
"اولین مقدار یا محدوده‌ای که هنگام محاسبه کمترین مقدار در نظر گرفته می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range to consider when counting."
msgstr "اولین مقدار یا محدوده‌ای که در شمارش لحاظ می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value."
msgstr "اولین مقدار."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first_period (%(first)s) must be smaller or equal to the last_period "
"(%(last)s)."
msgstr "دوره اول (%(first)s) باید کوچک‌تر یا مساوی دوره آخر (%(last)s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first_period (%s) must be strictly positive."
msgstr "دوره اول (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit should be 'k', 'm' or 'b'."
msgstr "واحد قالب‌بندی باید 'k'، 'm' یا 'b' باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit. Use 'k', 'm', or 'b' to force the unit"
msgstr "واحد قالب‌بندی؛ برای تعیین دستی واحد از 'k'، 'm' یا 'b' استفاده کنید"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formula must be valid"
msgstr "فرمول باید معتبر باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The frequency (%s) must be one of %s"
msgstr "دوره تناوب/بسامد (%s) باید یکی از مقادیر %s باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The full URL of the link enclosed in quotation marks."
msgstr "نشانی کامل اینترنتی (URL) داخل علامت نقل قول."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a boolean value, but '%s' is a text, "
"and cannot be coerced to a boolean."
msgstr ""
"تابع [[FUNCTION_NAME]] به یک مقدار منطقی (بولین) نیاز دارد، اما '%s' یک متن "
"است و نمی‌توان آن را به بولین تبدیل کرد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value between %s and %s "
"inclusive, but receives %s."
msgstr ""
"تابع [[FUNCTION_NAME]] انتظار مقداری عددی بین %s و %s (شامل هر دو) را دارد، "
"اما %s را دریافت کرد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value to be greater than or "
"equal to 1, but receives %s."
msgstr ""
"تابع [[FUNCTION_NAME]] انتظار مقداری عددی بزرگتر یا مساوی 1 را دارد، اما %s "
"را دریافت کرد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value, but '%s' is a string,"
" and cannot be coerced to a number."
msgstr ""
"تابع [[FUNCTION_NAME]] انتظار یک مقدار عددی دارد، اما '%s' یک رشته است و "
"نمی‌تواند به عدد تبدیل شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] has an argument with value '%s'. It should be"
" one of: %s."
msgstr ""
"تابع [[FUNCTION_NAME]] آرگومانی با مقدار '%s' دارد؛ این مقدار باید یکی از "
"موارد زیر باشد: %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function [[FUNCTION_NAME]] result cannot be negative"
msgstr "نتیجه تابع [[FUNCTION_NAME]] نمی‌تواند منفی باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] result must be greater than or equal "
"01/01/1900."
msgstr "نتیجه تابع [[FUNCTION_NAME]] باید بزرگتر یا مساوی 01/01/1900 باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function code (%s) must be between 1 to 11 or 101 to 111."
msgstr "کد تابع (%s) باید عددی بین 1 تا 11 یا 101 تا 111 باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function to use in subtotal aggregation."
msgstr "تابعی که برای تجمیع جمع‌های جزء (Subtotal) استفاده می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future value of the investment."
msgstr "ارزش آتی سرمایه‌گذاری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future value remaining after the final payment has been made."
msgstr "ارزش آتی باقی‌مانده پس از انجام آخرین پرداخت."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future_value (%s) must be strictly positive."
msgstr "ارزش آتی (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The header row of a table can't be moved."
msgstr "سطر سرآیند جدول را نمی‌توان جابه‌جا کرد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The high (%s) must be greater than or equal to the low (%s)."
msgstr "حد بالا (%s) باید بزرگ‌تر یا مساوی با حد پایین (%s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The high end of the random range."
msgstr "کران بالای محدوده تصادفی."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The hour component of the time."
msgstr "مؤلفه ساعت از زمان."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index from the left of string from which to begin extracting. The first "
"character in string has the index 1."
msgstr ""
"شاخص از سمت چپ رشته که استخراج از آن شروع می‌شود. شاخص اولین کاراکتر برابر "
"با 1 است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the column in range or a range outside of range containing the "
"values by which to sort."
msgstr ""
"شاخص ستون در محدوده، یا محدوده‌ای در خارج از آن که شامل مقادیر مبنای "
"مرتب‌سازی است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the column to be returned from within the reference range of "
"cells."
msgstr "شاخص ستونی که باید از محدوده مرجع سلول‌ها بازگردانده شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the row to be returned from within the reference range of "
"cells."
msgstr "شاخص سطری که باید از داخل محدوده مرجع سلول‌ها بازگردانده شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The info_type should be one of %s."
msgstr "نوع اطلاعات (info_type) باید یکی از موارد %s باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The initial cost of the asset."
msgstr "بهای تمام‌شده اولیه دارایی."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The initial string."
msgstr "رشته اولیه."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The instance of search_for within text_to_search to replace with "
"replace_with. By default, all occurrences of search_for are replaced; "
"however, if occurrence_number is specified, only the indicated instance of "
"search_for is replaced."
msgstr ""
"چندمین وقوع search_for درون text_to_search که باید با replace_with جایگزین "
"شود. به طور پیش‌فرض، همه رخدادهای search_for جایگزین می‌شوند؛ اما اگر "
"occurrence_number تعیین شود، تنها وقوع مشخص‌شده جایگزین خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The instance_num (%s) must not be zero."
msgstr "شماره وقوع (%s) نباید صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The interest rate paid on funds invested."
msgstr "نرخ بهره پرداخت‌شده برای وجوه سرمایه‌گذاری شده."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The interest rate."
msgstr "نرخ بهره."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment (%s) must be strictly positive."
msgstr "سرمایه‌گذاری (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment's current value."
msgstr "ارزش فعلی سرمایه‌گذاری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment's desired future value."
msgstr "ارزش آتی مطلوب سرمایه‌گذاری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The issue (%s) must be positive or null."
msgstr "تاریخ انتشار (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The key value is invalid"
msgstr "مقدار کلیدی نامعتبر است"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/pivot/pivot_functions.js:0
msgid "The label of the filter whose value to return."
msgstr "عنوان فیلتری که مقدار آن باید بازگردانده شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The last_period (%(last)s) must be smaller or equal to the number_of_periods"
" (%(nPeriods)s)."
msgstr ""
"دوره آخر (%(last)s) باید کوچک‌تر یا مساوی کل تعداد دوره‌ها (%(nPeriods)s) "
"باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The last_period (%s) must be strictly positive."
msgstr "دوره آخر (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The length of the segment to extract."
msgstr "طول بخشی از متن که باید استخراج شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The life (%s) must be strictly positive."
msgstr "طول عمر مفید (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The logarithm of a number, base e (euler's number)."
msgstr "لگاریتم طبیعی یک عدد بر مبنای e (عدد اویلر)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The logarithm of a number, for a given base."
msgstr "لگاریتم یک عدد بر مبنای پایه مشخص‌شده."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The low end of the random range."
msgstr "کران پایین محدوده تصادفی."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The lower inflection point value must be a number"
msgstr "مقدار نقطه عطف پایین باید یک عدد باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The matrix is not invertible."
msgstr "ماتریس وارون‌پذیر (معکوس‌پذیر) نیست."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maturity (%(maturity)s) must be strictly greater than the settlement "
"(%(settlement)s)."
msgstr ""
"تاریخ سررسید (%(maturity)s) باید اکیداً بزرگتر از تاریخ تسویه "
"(%(settlement)s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maturity date of the security."
msgstr "تاریخ سررسید اوراق بهادار."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maturity or end date of the security, when it can be redeemed at face, "
"or par value."
msgstr ""
"تاریخ سررسید یا خاتمه اوراق بهادار که در آن زمان به ارزش اسمی بازخرید "
"می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum (%s) and minimum (%s) must be integers when whole_number is "
"TRUE."
msgstr ""
"وقتی whole_number برابر TRUE است، حداکثر (%s) و حداقل (%s) باید اعداد صحیح "
"باشند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum (%s) must be greater than or equal to the minimum (%s)."
msgstr "حداکثر (%s) باید بزرگتر یا مساوی حداقل (%s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum number of cells for each column, rounded down to the nearest "
"whole number."
msgstr ""
"حداکثر تعداد سلول‌ها برای هر ستون، که به نزدیک‌ترین عدد صحیح پایین‌تر گرد "
"می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum number of cells for each row, rounded down to the nearest whole "
"number."
msgstr ""
"حداکثر تعداد سلول‌ها برای هر سطر، که به نزدیک‌ترین عدد صحیح پایین‌تر گرد "
"می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum number you would like returned."
msgstr "حداکثر عددی که می‌خواهید بازگردانده شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum range limit value must be a number"
msgstr "مقدار حد بالای بازه باید یک عدد باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maxpoint must be a number"
msgstr "نقطه حداکثر (Maxpoint) باید یک عدد باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/chart/odoo_chart/odoo_chart_helpers.js:0
msgid ""
"The menu linked to this chart doesn't have an corresponding action. Please "
"link the chart to another menu."
msgstr ""
"منوی متصل به این نمودار اقدام (اکشن) متناظری ندارد. لطفاً نمودار را به منوی "
"دیگری پیوند دهید."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The midpoint must be a number"
msgstr "نقطه میانی (Midpoint) باید یک عدد باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minimum number you would like returned."
msgstr "حداقل عددی که می‌خواهید بازگردانده شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minimum range limit value must be a number"
msgstr "مقدار حد پایین بازه باید یک عدد باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minpoint must be a number"
msgstr "نقطه حداقل (Minpoint) باید یک عدد باشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minuend, or number to be subtracted from."
msgstr "مفروق‌منه (عددی که باید از آن کسر شود)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minute component of the time."
msgstr "مؤلفه دقیقه از زمان."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/data_sources/data_source.js:0
#: code:addons/spreadsheet/static/src/pivot/odoo_pivot_loader.js:0
msgid "The model \"%(model)s\" does not exist."
msgstr "مدل \"%(model)s\" وجود ندارد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/global_filters/components/filter_value/filter_value.js:0
msgid ""
"The model (%(model)s) of this global filter is not valid (it may have been "
"renamed/deleted)."
msgstr ""
"مدل (%(model)s) این فیلتر سراسری معتبر نیست (احتمالاً تغییر نام یافته یا حذف"
" شده است)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The month (%s) must be between 1 and 12 inclusive."
msgstr "ماه (%s) باید عددی بین 1 تا 12 (شامل هر دو) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The month component of the date."
msgstr "مؤلفه ماه از تاریخ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The net present value of an investment based on a series of periodic cash "
"flows and a discount rate."
msgstr ""
"ارزش فعلی خالص (NPV) سرمایه‌گذاری بر اساس مجموعه‌ای از جریان‌های نقدی "
"دوره‌ای و نرخ تنزیل."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The nominal interest rate per year."
msgstr "نرخ بهره اسمی سالانه."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The nominal_rate (%s) must be strictly positive."
msgstr "نرخ اسمی (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number for which to calculate the positive square root."
msgstr "عددی که ریشه دوم (جذر) مثبت آن محاسبه می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters in the text to be replaced."
msgstr "تعداد کاراکترهای متنی که باید جایگزین شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters to return from the left side of string."
msgstr "تعداد کاراکترهایی که باید از سمت چپ رشته بازگردانده شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters to return from the right side of string."
msgstr "تعداد کاراکترهایی که باید از سمت راست رشته بازگردانده شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns (%s) must be positive."
msgstr "تعداد ستون‌ها (%s) باید عددی مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns in the constrained array."
msgstr "تعداد ستون‌ها در آرایه محدودشده."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns in the expanded array. If missing, columns will not be"
" expanded."
msgstr ""
"تعداد ستون‌ها در آرایه بسط‌یافته؛ در صورت خالی بودن، ستون‌ها گسترش نخواهند "
"یافت."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns must be positive."
msgstr "تعداد ستون‌ها باید مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns of the range to return starting at the offset target."
msgstr ""
"تعداد ستون‌های محدوده‌ای که بازگردانده می‌شود با شروع از نقطه مقصد آفست."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to be returned."
msgstr "تعداد ستون‌هایی که باید بازگردانده شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to offset by."
msgstr "تعداد ستون‌هایی که باید آفست (جابه‌جا) شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to return"
msgstr "تعداد ستون‌هایی که باید برگردانده شوند"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of compounding periods per year."
msgstr "تعداد دوره‌های مرکب شدن سود در سال."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of days between start_date and end_date"
msgstr "تعداد روزهای بین start_date و end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of days between start_date and end_date after subtracting whole "
"months"
msgstr "تعداد روزهای بین start_date و end_date پس از کسر ماه‌های کامل"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of days between start_date and end_date, assuming start_date and "
"end_date were no more than one year apart"
msgstr ""
"تعداد روزهای بین start_date و end_date با این فرض که فاصله آنها بیش از یک "
"سال نباشد"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of decimal places to which to round."
msgstr "تعداد ارقام بعد از اعشار برای گرد کردن."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of interest or coupon payments per year (1, 2, or 4)."
msgstr "تعداد دفعات پرداخت سود یا کوپن در سال (۱، ۲ یا ۴)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of items to return."
msgstr "تعداد مواردی که باید بازگردانده شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of months before (negative) or after (positive) 'start_date' to "
"calculate."
msgstr "تعداد ماه‌های قبل (منفی) یا بعد (مثبت) از 'start_date' برای محاسبه."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of months before (negative) or after (positive) 'start_date' to "
"consider."
msgstr ""
"تعداد ماه‌های قبل (منفی) یا بعد (مثبت) از 'start_date' جهت لحاظ در محاسبه."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of months in the first year of depreciation."
msgstr "تعداد ماه‌ها در سال اول استهلاک."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of numeric values in dataset."
msgstr "تعداد مقادیر عددی در مجموعه داده."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of payments to be made."
msgstr "تعداد اقساط یا پرداخت‌هایی که باید انجام شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods over which the asset is depreciated."
msgstr "تعداد دوره‌هایی که دارایی طی آن مستهلک می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods."
msgstr "تعداد دوره‌ها."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows (%s) must be positive."
msgstr "تعداد سطرها (%s) باید عددی مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows in the constrained array."
msgstr "تعداد سطرها در آرایه محدودشده."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows in the expanded array. If missing, rows will not be "
"expanded."
msgstr ""
"تعداد سطرها در آرایه بسط‌یافته؛ در صورت خالی بودن، سطرها گسترش نخواهند یافت."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows must be positive."
msgstr "تعداد سطرها باید مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows of the range to return starting at the offset target."
msgstr ""
"تعداد سطرهای محدوده‌ای که بازگردانده می‌شود با شروع از نقطه مقصد آفست."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to be returned."
msgstr "تعداد سطرهایی که باید بازگردانده شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to offset by."
msgstr "تعداد سطرهایی که باید آفست (جابه‌جا) شوند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to return"
msgstr "تعداد سطرهایی که باید برگردانده شوند"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of significant digits to the right of the decimal point to "
"retain."
msgstr "تعداد ارقام معنادار بعد از ممیز اعشار جهت نگهداری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of the character to look up from the current Unicode table in "
"decimal format."
msgstr "کد ده‌دهی کاراکتر برای جستجو در جدول یونیکد جاری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to begin the cumulative calculation."
msgstr "شماره دوره پرداختی که محاسبه تجمعی از آن شروع می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to end the cumulative calculation."
msgstr "شماره دوره پرداختی که محاسبه تجمعی به آن ختم می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of values in a dataset."
msgstr "تعداد مقادیر موجود در مجموعه داده."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of which to return the absolute value."
msgstr "عددی که قدر مطلق آن بازگردانده می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole months between start_date and end_date"
msgstr "تعداد ماه‌های کامل بین start_date و end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of whole months between start_date and end_date after subtracting"
" whole years"
msgstr "تعداد ماه‌های کامل بین start_date و end_date پس از کسر سال‌های کامل"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole years between start_date and end_date"
msgstr "تعداد سال‌های کامل بین start_date و end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of working days to advance from start_date. If negative, counts "
"backwards."
msgstr ""
"تعداد روزهای کاری که باید از start_date به جلو حرکت شود؛ در صورت منفی بودن "
"به عقب شمرده می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number pi."
msgstr "عدد پی (π)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided to find the remainder."
msgstr "عددی که برای به دست آوردن باقی‌مانده تقسیم می‌شود (مقسوم)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided."
msgstr "عددی که تقسیم می‌شود (مقسوم)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to convert."
msgstr "عددی که باید تبدیل شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to divide by."
msgstr "عددی که بر آن تقسیم می‌شود (مقسوم‌علیه)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to have its sign reversed. Equivalently, the number to multiply "
"by -1."
msgstr "عددی که علامت آن معکوس می‌شود؛ یا به عبارت دیگر، در -1 ضرب می‌گردد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to raise to the exponent power."
msgstr "عددی که باید به توان برسد (پایه)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to return."
msgstr "عددی که باید بازگردانده شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to round down to the nearest integer."
msgstr "عددی که باید به سمت پایین به نزدیک‌ترین عدد صحیح گرد شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples number will be rounded."
msgstr "عددی که مقدار به مضرب‌های آن گرد خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to whose multiples number will be rounded. The sign of "
"significance will be ignored."
msgstr ""
"عددی که مقدار به مضرب‌های آن گرد خواهد شد. علامت اهمیت نادیده گرفته خواهد "
"شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples value will be rounded."
msgstr "عددی که مقدار به مضرب‌های آن گرد خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number, date or time to format."
msgstr "عدد، تاریخ یا زمانی که باید قالب‌بندی شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number."
msgstr "عدد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_characters (%s) must be positive or null."
msgstr "تعداد نویسه‌ها (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be different from zero."
msgstr "تعداد دوره‌ها (%s) نباید صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be strictly positive."
msgstr "تعداد دوره‌ها (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The occurrenceNumber (%s) must be positive or null."
msgstr "شماره وقوع (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The one-dimensional array to be searched."
msgstr "آرایه یک‌بعدی که باید در آن جستجو شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The order of the polynomial to fit the data, between 1 and 6."
msgstr "درجه چندجمله‌ای برای برازش داده‌ها، بین ۱ تا ۶."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The other range whose entries will be multiplied with corresponding entries "
"in the other ranges."
msgstr ""
"محدوده دیگری که درآمدهای آن در مقادیر متناظر در سایر محدوده‌ها ضرب خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range."
msgstr "الگو یا آزمونی که باید به محدوده معیارها اعمال شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The pattern or test to apply to criteria_range1, such that each cell that "
"evaluates to TRUE will be included in the filtered set."
msgstr ""
"الگو یا آزمونی که باید به محدوده معیار ۱ اعمال شود، به طوری که هر سلولی که "
"نتیجه آن TRUE شود، در مجموعه فیلترشده قرار گیرد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range1."
msgstr "الگو یا آزمونی که باید به محدوده معیار ۱ اعمال شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range2."
msgstr "الگو یا آزمونی که باید به محدوده معیار ۲ اعمال شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to range."
msgstr "الگو یا آزمونی که باید به محدوده اعمال شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The percentile whose value within data will be calculated and returned."
msgstr "صدمک (پرسنتیلی) که مقدار آن در داده‌ها محاسبه و بازگردانده خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The percentile, exclusive of 0 and 1, whose value within 'data' will be "
"calculated and returned."
msgstr ""
"صدمک (پرسنتیل)، به استثنای ۰ و ۱، که مقدار آن در «داده» محاسبه و بازگردانده "
"خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal life (%(life)s)."
msgstr "دوره (%(period)s) باید کمتر یا مساوی عمر مفید (%(life)s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal to %(lifeLimit)s."
msgstr "دوره (%(period)s) باید کمتر یا مساوی %(lifeLimit)s باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be positive or null."
msgstr "دوره (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be strictly positive."
msgstr "دوره (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period for which you want to view the interest payment."
msgstr "دوره‌ای که می‌خواهید پرداخت سود را برای آن مشاهده کنید."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period must be between 1 and number_of_periods (%s)"
msgstr "دوره باید بین ۱ و تعداد دوره‌ها (%s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The periods_by_year (%s) must be strictly positive."
msgstr "دوره‌ها در سال (%s) باید اکیداً مثبت باشند."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains a reserved value"
msgstr "جدول پیوت قابل ایجاد نیست زیرا سلول %s حاوی یک مقدار رزرو شده است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains an error"
msgstr "جدول پیوت قابل ایجاد نیست زیرا سلول %s حاوی خطا است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s is empty"
msgstr "جدول پیوت قابل ایجاد نیست زیرا سلول %s خالی است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because the dataset is missing."
msgstr "جدول پیوت قابل ایجاد نیست زیرا مجموعه داده وجود ندارد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position (%s) must be greater than or equal to 1."
msgstr "موقعیت (%s) باید بزرگ‌تر یا مساوی ۱ باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position where the replacement will begin (starting from 1)."
msgstr "موقعیتی که جایگزینی از آنجا آغاز خواهد شد (شروع از ۱)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present value of the investment."
msgstr "ارزش فعلی سرمایه‌گذاری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present_value (%s) must be strictly positive."
msgstr "ارزش فعلی (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price (%s) must be strictly positive."
msgstr "قیمت (%s) باید اکیداً مثبت باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought per 100 face value."
msgstr "قیمتی که اوراق بهادار به ازای ۱۰۰ ارزش اسمی خریداری می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought."
msgstr "قیمتی که اوراق بهادار خریداری می‌شود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given as a decimal value."
msgstr "مظنه قیمت ارائه شده به صورت یک مقدار اعشاری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given using fractional decimal conventions."
msgstr "مظنه قیمت ارائه شده با استفاده از قراردادهای اعشاری کسری."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The purchase_date (%(purchaseDate)s) must be before the first_period_end "
"(%(firstPeriodEnd)s)."
msgstr ""
"تاریخ خرید (%(purchaseDate)s) باید قبل از پایان اولین دوره "
"(%(firstPeriodEnd)s) باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The purchase_date (%s) must be positive or null."
msgstr "تاریخ خرید (%s) باید مثبت یا صفر باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the dataset to consider."
msgstr "محدوده‌ای که شامل مجموعه داده موردنظر است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range containing the return value. Should have the same dimensions as "
"lookup_range."
msgstr ""
"محدوده‌ای که شامل مقدار بازگشتی است. باید ابعاد یکسانی با lookup_range داشته"
" باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the set of classes."
msgstr "محدوده‌ای که شامل مجموعه کلاس‌ها است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range from which to return a result. The value returned corresponds to "
"the location where search_key is found in search_range. This range must be "
"only a single row or column and should not be used if using the "
"search_result_array method."
msgstr ""
"محدوده‌ای که نتیجه از آن بازگردانده می‌شود. مقدار بازگشتی مطابق با مکانی است"
" که search_key در search_range پیدا می‌شود. این محدوده باید فقط یک سطر یا "
"ستون باشد و نباید در صورت استفاده از روش search_result_array به کار رود."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is invalid"
msgstr "محدوده نامعتبر است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is invalid."
msgstr "محدوده نامعتبر است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is out of bounds."
msgstr "محدوده خارج از حدود مجاز است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is out of the sheet"
msgstr "محدوده خارج از برگه است."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range must be a single row or a single column."
msgstr "محدوده باید یک سطر واحد یا یک ستون واحد باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range of cells from which the maximum will be determined."
msgstr "محدوده سلول‌هایی که حداکثر مقدار از آن تعیین خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range of cells from which the minimum will be determined."
msgstr "محدوده سلول‌هایی که حداقل مقدار از آن تعیین خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range of cells from which the number of unique values will be counted."
msgstr "محدوده سلول‌هایی که تعداد مقادیر یکتا از آن شمارش خواهد شد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range of cells from which the values are returned."
