#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The settlement date (%(settlement)s) must be strictly greater than the issue"
" date (%(issue)s)."
msgstr ""
"تاریخ تسویه (%(settlement)s) باید اکیداً بزرگ‌تر از تاریخ انتشار (%(issue)s)"
" باشد."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
