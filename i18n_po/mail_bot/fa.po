#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"وای این خیلی بامزه است، اما می‌دونی، ربات‌ها این‌طوری کار نمی‌کنند. تو برای "
"من بیش از حد انسانی! بیایید حرفه‌ای بمانیم ❤️"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "غیرفعال‌شده"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "کانال گفتگو"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "نام نمایشی"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app."
msgstr ""
"عالی! می‌توانید %(bold_start)سخنان ازپیش‌آماده%(bold_end) را در برنامه گفتگو"
" سفارشی کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! 👍%(new_line)sTo access special commands, %(bold_start)sstart your "
"sentence with%(bold_end)s %(command_start)s/%(command_end)s. Try getting "
"help."
msgstr ""
"عالی! 👍%(new_line)sبرای دسترسی به دستورات ویژه، %(bold_start)جمله خود را "
"با%(bold_end) %(command_start)s/%(command_end) شروع کنید. دریافت راهنما را "
"امتحان کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello,"
msgstr "سلام،"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "هوممم..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "متأسفم، متوجه نمی‌شوم. عذرخواهم!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide,"
" ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"من به اندازه کافی باهوش نیستم که به سوال شما پاسخ دهم.%(new_line)sبرای دنبال"
" کردن راهنمای من، بپرسید: %(command_start)sstart the tour%(command_end)s."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
#: model:ir.model.fields,field_description:mail_bot.field_res_users__id
msgid "ID"
msgstr "شناسه"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "بیکار"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "ربات ایمیل"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not exactly. To continue the tour, send an emoji: "
"%(bold_start)stype%(bold_end)s%(command_start)s :)%(command_end)s and press "
"enter."
msgstr ""
"دقیقاً نه. برای ادامه تور، یک ایموجی بفرستید: "
"%(bold_start)stype%(bold_end)s%(command_start)s :)%(command_end) را تایپ "
"کرده و اینتر بزنید."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "مقداردهی اولیه نشده"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s/%(command_end)s "
"and wait for the propositions. Select %(command_start)shelp%(command_end)s "
"and press enter."
msgstr ""
"مطمئن نیستم چه کار می‌کنید. لطفاً %(command_start)s/%(command_end) را تایپ "
"کنید و منتظر پیشنهادها بمانید. گزینه %(command_start)shelp%(command_end) را "
"انتخاب کرده و اینتر بزنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s:%(command_end)s "
"and wait for the propositions. Select one of them and press enter."
msgstr ""
"مطمئن نیستم چه کار می‌کنید. لطفاً %(command_start)s:%(command_end) را تایپ "
"کنید و منتظر پیشنهادها بمانید. یکی از آن‌ها را انتخاب کرده و اینتر بزنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's chat helps employees collaborate efficiently. I'm here to help you "
"discover its features."
msgstr ""
"چت مِنو به کارمندان کمک می‌کند به طور مؤثری همکاری کنند. من اینجا هستم تا به"
" شما کمک کنم ویژگی‌های آن را کشف کنید."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "وضعیت ربات مِنو"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "ربات مِنو ناموفق بود"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "پیوست شروع به کار"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "پاسخ ازپیش‌آماده شروع به کار"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "دستور شروع به کار"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "ایموجی شروع به کار"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "پینگ شروع به کار"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: "
"%(command_start)sstart the tour%(command_end)s."
msgstr ""
"ببخشید خوابم می‌آید. یا شاید هم نه! شاید فقط دارم سعی می‌کنم ناآگاهی‌ام از "
"زبان انسان را پنهان کنم...%(new_line)sاگر بنویسید: %(command_start)sstart "
"the tour%(command_end)s، می‌توانم ویژگی‌ها را به شما نشان دهم."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I am not listening. To get someone's attention, %(bold_start)sping "
"him%(bold_end)s. Write %(command_start)s@OdooBot%(command_end)s and select "
"me."
msgstr ""
"متأسفم، گوش نمی‌دهم. برای جلب توجه کسی، %(bold_start)او را پینگ "
"کنید%(bold_end). بنویسید %(command_start)s@OdooBot%(command_end) و مرا "
"انتخاب کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "سپاس"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "از بازخورد شما متشکرم. خداحافظ!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "این قشنگ نیست! من یک رباتم اما احساس دارم... 💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That’s the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the "
"tour%(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"این پایان این مرور کلی است. می‌توانید %(bold_start)sاین گفتگو را "
"ببندید%(bold_end) یا عبارت %(command_start)sstart the tour%(command_end) را "
"تایپ کنید تا دوباره آن را ببینید. از کاوش در مِنو لذت ببرید!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "This is a temporary canned response to see how canned responses work."
msgstr ""
"این یک پاسخ ازپیش‌آماده موقت است تا ببینید پاسخ‌های ازپیش‌آماده چگونه کار "
"می‌کنند."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, click on the "
"%(paperclip_icon)s icon and select a file."
msgstr ""
"برای %(bold_start)sارسال پیوست%(bold_end)، روی آیکون %(paperclip_icon) کلیک "
"کرده و یک فایل را انتخاب کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To start, try to send me an emoji :)"
msgstr "برای شروع، سعی کنید یک ایموجی برای من بفرستید :)"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Try to send me an emoji"
msgstr "سعی کنید یک ایموجی برای من بفرستید"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand! If you need help "
"discovering our product, please check %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour "
"videos%(slides_link_end)s."
msgstr ""
"متأسفانه من فقط یک ربات هستم 😞 متوجه نمی‌شوم! اگر برای کشف محصول ما به کمک "
"نیاز دارید، لطفاً %(document_link_start)sمستندات ما%(document_link_end) یا "
"%(slides_link_start)sویدیوهای ما%(slides_link_end) را بررسی کنید."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "کاربر"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to use"
" canned responses. I've created a temporary one for you."
msgstr ""
"عالی! 😇%(new_line)سعي کنید %(command_start)s::%(command_end) را تایپ کنید تا"
" از پاسخ‌های ازپیش‌آماده استفاده کنید. من یک نمونه موقت برای شما ایجاد "
"کرده‌ام."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow you are a natural!%(new_line)sPing someone with @username to grab their "
"attention. %(bold_start)sTry to ping me using%(bold_end)s "
"%(command_start)s@OdooBot%(command_end)s in a sentence."
msgstr ""
"وای تو یک نابغه ذاتی هستید!%(new_line)س با استفاده از نام کاربری (@username)"
" کسی را پینگ کنید تا توجهش جلب شود. %(bold_start)سعی کنید مرا پینگ کنید با "
"استفاده از%(bold_end) %(command_start)s@OdooBot%(command_end) در یک جمله."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I am here! 🎉 %(new_line)sNow, try %(bold_start)ssending an "
"attachment%(bold_end)s, like a picture of your cute dog..."
msgstr ""
"بله، من اینجا هستم! 🎉 %(new_line)اکنون، سعی کنید %(bold_start)سایپوست ارسال "
"کنید%(bold_end)، مانند عکسی از سگ بانمکت..."

