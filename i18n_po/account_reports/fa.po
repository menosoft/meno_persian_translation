#. module: account_reports
#: model:mail.template,body_html:account_reports.email_template_generic_tax_instructions
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    Dear <t t-out=\"object.company_id.name\">YourCompany</t>,\n"
"                </p>\n"
"                <p>\n"
"                    Based on the documents and information received, the VAT return of <t t-out=\"object.company_id.name\">YourCompany</t>\n"
"                    for period <t t-out=\"object.type_id._get_period_name(object.company_id, object.date_from, object.date_to)\"/> has been submitted.\n"
"                </p>\n"
"                <p>\n"
"                    It has been determined that an amount of <t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/> remains payable.\n"
"                </p>\n"
"                <table style=\"border:1px solid black; padding:20px; text-align:left; border-spacing: 16px;\">\n"
"                    <tr>\n"
"                        <td>Amount to Pay</td>\n"
"                        <td><t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>Due By</td>\n"
"                        <td><t t-out=\"format_date(object.date_deadline)\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>Kind regards,</p>\n"
"                <p><t t-out=\"user.name\">Mitchell Admin</t></p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    <t t-out=\"object.company_id.name\">شرکت شما</t> گرامی،\n"
"                </p>\n"
"                <p>\n"
"                    بر اساس اسناد و اطلاعات دریافتی، اظهارنامه مالیات بر ارزش افزوده <t t-out=\"object.company_id.name\">شرکت شما</t>\n"
"                    برای دوره <t t-out=\"object.type_id._get_period_name(object.company_id, object.date_from, object.date_to)\"/> ثبت شد.\n"
"                </p>\n"
"                <p>\n"
"                    مشخص شد که مبلغ <t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/> همچنان قابل پرداخت است.\n"
"                </p>\n"
"                <table style=\"border:1px solid black; padding:20px; text-align:right; border-spacing: 16px;\">\n"
"                    <tr>\n"
"                        <td>مبلغ قابل پرداخت</td>\n"
"                        <td><t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>سررسید تا</td>\n"
"                        <td><t t-out=\"format_date(object.date_deadline)\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>با احترام،</p>\n"
"                <p><t t-out=\"user.name\">میچل ادمین</t></p>\n"
"            </div>\n"
"        "

