#. module: base_iban
#. odoo-python
#: code:addons/base_iban/models/res_partner_bank.py:0
msgid ""
"The IBAN does not seem to be correct. You should have entered something like this %s\n"
"Where B = National bank code, S = Branch code, C = Account No, k = Check digit"
msgstr ""
"به نظر می‌رسد شماره شبا (IBAN) صحیح نباشد. شما باید چیزی شبیه به این وارد می‌کردید: %s\n"
"که در آن B = کد ملی بانک، S = کد شعبه، C = شماره حساب، k = رقم کنترلی"

#. module: base_iban
#. odoo-python
#: code:addons/base_iban/models/res_partner_bank.py:0
