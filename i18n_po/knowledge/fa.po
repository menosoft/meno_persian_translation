msgstr "<span style=\"font-size: 14px;\">موارد زیر را امتحان کنید 👇</span>"

#. module: knowledge
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">You can use the clipboard as a description,"
" a message or simply copy it to your clipboard! 👌</span>"
msgstr ""
"<span style=\"font-size: 14px;\">می‌توانید از کلیپ‌بورد به عنوان یک توضیحات،"
" یک پیام استفاده کنید یا به سادگی آن را در کلیپ‌بورد خود کپی کنید! 👌</span>"

