#. module: meno_backend_fonts
#: model_terms:ir.ui.view,arch_db:meno_backend_fonts.res_config_settings_view_form_meno_font
msgid ""
"در این سیستم افتخار استفاده از خانواده فونت‌های بی‌نظیر <b>وزیرمتن، شبنم، صمیم و ساحل</b> را داریم. \n"
"                                بدین‌وسیله یاد و خاطره‌ی <strong>زنده‌یاد صابر راستی‌کردار</strong>، برنامه‌نویس و طراح باسخاوت ایرانی را گرامی می‌داریم؛\n"
"                                کسی که با روحیه متن‌باز، آزادگی و عشق بی‌پایان به جامعه کاربری، جلوه‌ای نو به تایپوگرافی وب فارسی هدیه داد و اثری ابدی بر جای گذاشت. \n"
"                                روحش شاد و نامش همواره جاودان باد."
msgstr ""
"در این سیستم افتخار استفاده از خانواده فونت‌های بی‌نظیر <b>وزیرمتن، شبنم، صمیم و ساحل</b> را داریم. \n"
"                                بدین‌وسیله یاد و خاطره‌ی <strong>زنده‌یاد صابر راستی‌کردار</strong>، برنامه‌نویس و طراح سخاوتمند ایرانی را گرامی می‌داریم؛\n"
"                                کسی که با روحیه متن‌باز، آزادگی و عشق بی‌پایان به جامعه کاربری، جلوه‌ای نو به تایپوگرافی وب فارسی هدیه داد و اثری ابدی بر جای گذاشت. \n"
"                                روحش شاد و نامش همواره جاودان باد."

#. module: meno_backend_fonts
#: model_terms:ir.ui.view,arch_db:meno_backend_fonts.res_config_settings_view_form_meno_font
msgid "سپس بر روی دکمه <b>«اعمال دائمی و کامپایل مجدد فونت‌ها»</b> کلیک کنید."
msgstr "سپس روی دکمه <b>«اعمال دائمی و کامپایل مجدد فونت‌ها»</b> کلیک کنید."

