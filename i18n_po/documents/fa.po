"white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                    <tr><td valign=\"middle\">\n"
"                                        <span style=\"font-size: 10px;\" t-if=\"len(documents) == 1\">\n"
"                                            سند اشتراک‌گذاری شده<br/>\n"
"                                            <span style=\"font-size: 20px; font-weight: bold;\" t-out=\"documents.name or ''\"/>\n"
