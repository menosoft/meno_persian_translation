"                                    <tr><td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                        <div>\n"
"                                            سلام <t t-out=\"object.name\"/>،\n"
"                                            <br/><br/>\n"
"                                            <t t-if=\"len(documents) &lt;= 1\">\n"
"                                                <t t-if=\"documents.type == 'folder'\" t-set=\"share_message\">پوشه زیر را با شما به اشتراک گذاشته است</"
"t>\n"
"                                                <t t-else=\"\" t-set=\"share_message\">سند زیر را با شما به اشتراک گذاشته است</t>\n"
"                                            </t>\n"
"                                            <t t-elif=\"len(documents) &gt; 1\">\n"
"                                                <t t-set=\"document_types\" t-value=\"set(documents.mapped('type'))\"/>\n"
