#. module: stock_sms
#: model:sms.template,body:stock_sms.sms_template_data_stock_delivery
msgid ""
"\n"
"                {{ (object.company_id.name + ': We are glad to inform you that your order n° ' + object.origin + ' has been "
"shipped.' if object.origin else object.company_id.name + ': We are glad to inform you that your order has been shipped.') + (' "
"Your tracking reference is ' + (object.carrier_tracking_ref) + '.' if hasattr(object, 'carrier_tracking_ref') and object."
"carrier_tracking_ref else '') }}\n"
"            "
msgstr ""
"\n"
"                {{ (object.company_id.name + ': خوشحالیم به اطلاعتان برسانیم که سفارش شماره ' + object.origin + ' شما ارسال شده "
"است.' if object.origin else object.company_id.name + ': خوشحالیم به اطلاعتان برسانیم که سفارش شما ارسال شده است.') + (' شماره "
"پیگیری مرسوله شما ' + (object.carrier_tracking_ref) + ' می‌باشد.' if hasattr(object, 'carrier_tracking_ref') and object."
"carrier_tracking_ref else '') }}\n"
"            "

