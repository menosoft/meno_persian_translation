#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_confirm
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        An appraisal of <t t-out=\"ctx.get('employee_to_name')\">employee</t> has been confirmed.\n"
"                        <br/><br/>\n"
"                        Please schedule an appraisal date together.\n"
"                        <br/><br/>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        ارزیابی عملکرد مربوط به <t t-out=\"ctx.get('employee_to_name')\">employee</t> تأیید شد.\n"
"                        <br/><br/>\n"
"                        لطفاً با هماهنگی یکدیگر تاریخ ارزیابی را تنظیم فرمایید.\n"
"                        <br/><br/>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-style=\"background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                                    مشاهده ارزیابی\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div> "

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_request_from_employee
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-out=\"ctx.get('employee_to_name')\">employee</t>,\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_name', '')\">Addison Olson</t> (<t t-out=\"ctx.get('author_mail', '')\">addison.olson28@example.com</t>) wishes an appraisal.\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div style=\"margin: 16px 0px 16px 0px; padding: 8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\">Annual appraisal.</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; padding: 8px 16px 8px 16px; text-align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-style=\" margin: auto; background-color: {{object.employee_id.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.employee_id.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        همکار گرامی <t t-out=\"ctx.get('employee_to_name')\">employee</t>،\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_name', '')\">Addison Olson</t> (<t t-out=\"ctx.get('author_mail', '')\">addison.olson28@example.com</t>) درخواست ارزیابی عملکرد دارد.\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div style=\"margin: 16px 0px 16px 0px; padding: 8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\">ارزیابی سالانه.</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; padding: 8px 16px 8px 16px; text-align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-style=\" margin: auto; background-color: {{object.employee_id.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.employee_id.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                                    مشاهده ارزیابی\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div> "

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hi <t t-out=\"ctx.get('employee_to_name')\">[employee]</t>,\n"
"                        <br/>\n"
"                        Just a quick reminder that your next appraisal with <t t-out=\"ctx.get('manager_names')\"> [Appraisers]</t>\n"
"                        is scheduled for <t t-out=\"ctx.get('date_close')\">[deadline]</t>.\n"
"                        <br/>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                                <t t-out=\"ctx.get('user_body')\">[Optional comment]</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            You can access your appraisal form here:\n"
"                            <p class=\"text-center my-3 py-2 px-3\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-style=\" margin: auto; background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                        If you have any questions or need to reschedule, feel free to reach out.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_signature')\"/>\n"
"                        <br/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        درود <t t-out=\"ctx.get('employee_to_name')\">[کارمند]</t>،\n"
"                        <br/>\n"
"                        یادآوری می‌شود که جلسه ارزیابی بعدی شما با <t t-out=\"ctx.get('manager_names')\"> [ارزیاب‌ها]</t>\n"
"                        برای تاریخ <t t-out=\"ctx.get('date_close')\">[مهلت نهایی]</t> زمان‌بندی شده است.\n"
"                        <br/>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                                <t t-out=\"ctx.get('user_body')\">[توضیحات تکمیلی]</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            می‌توانید به فرم ارزیابی خود از طریق پیوند زیر دسترسی داشته باشید:\n"
"                            <p class=\"text-center my-3 py-2 px-3\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-style=\" margin: auto; background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">\n"
"                                    مشاهده ارزیابی\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                        در صورت وجود هرگونه پرسش یا نیاز به تغییر زمان، با ما در ارتباط باشید.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_signature')\"/>\n"
"                        <br/>\n"
"                    </p>\n"
"                </div> "

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Describe something you are proud of—work that had a positive impact on\n"
"                        the company.\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        دستاوردی را شرح دهید که به آن افتخار می‌کنید؛ فعالیتی که تأثیر مثبتی بر سازمان داشته است.\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Did you face any new difficulties or unexpected obstacles?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        آیا با چالش‌های جدید یا موانع پیش‌بینی‌نشده‌ای مواجه شده‌اید؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Every job has its strong points. In your opinion, which tasks do you \n"
"                        enjoy the most and which the least?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        هر شغلی جذابیت‌های خود را دارد. به نظر شما، از انجام کدام وظایف بیشترین لذت و از کدام‌یک کمترین لذت را می‌برید؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        From a manager’s point of view, how could you help them overcome their weaknesses?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        از دیدگاه مدیریتی، چگونه می‌توانید به آن‌ها در رفع نقاط ضعفشان کمک کنید؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        How can the company support your needs and objectives to help you \n"
"                        reach your goals and foster better collaboration?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        سازمان چگونه می‌تواند از نیازها و اهداف شما برای دستیابی به مقاصد کاری و تقویت همکاری تیمی پشتیبانی کند؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        How do you see the employee in the future? Does your vision align with \n"
"                        the employee’s goals?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        آینده این همکار را چگونه می‌بینید؟ آیا دیدگاه شما با اهداف توسعه فردی وی همسو است؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Mention any achievements that demonstrate their strengths in \n"
"                        handling work-related challenges.\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        به دستاوردهایی اشاره کنید که نشان‌دهنده توانمندی وی در مدیریت چالش‌های کاری بوده است.\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid "<em>Autonomy</em>"
msgstr "<em>استقلال کاری</em>"

