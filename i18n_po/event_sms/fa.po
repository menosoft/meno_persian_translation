#. module: event_sms
#: model:sms.template,body:event_sms.sms_template_data_event_reminder
msgid ""
"Ready for \"{{ object.event_id.name }}\" {{ object.event_date_range }}?\n"
"{{ 'It starts at %s' % format_time(time=object.event_begin_date, tz=object.event_id.date_tz, time_format='short', lang_code=object.partner_id.lang) + (', at %s' % object.event_id.address_inline if object.event_id.address_inline else '') + '.\\nSee you there!' if object.event_id.address_inline or 'website_published' not in object.event_id._fields else 'Join us on %s/event/%i!' % (object.get_base_url(), object.event_id.id) }}"
msgstr ""
"برای رویداد \"{{ object.event_id.name }}\" در بازه {{ object.event_date_range }} آماده‌اید؟\n"
"{{ 'شروع در ساعت %s' % format_time(time=object.event_begin_date, tz=object.event_id.date_tz, time_format='short', lang_code=object.partner_id.lang) + (', در %s' % object.event_id.address_inline if object.event_id.address_inline else '') + '.\\nبه زودی می‌بینیمتون!' if object.event_id.address_inline or 'website_published' not in object.event_id._fields else 'به ما در %s/event/%i بپیوندید!' % (object.get_base_url(), object.event_id.id) }}"

