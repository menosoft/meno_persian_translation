#. module: industry_fsm_sale
#. odoo-python
#: code:addons/industry_fsm_sale/models/project_task.py:0
msgid ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                            No products found. Let's create one!\n"
"                        </p><p>\n"
"                            Keep track of the products you are using to complete your tasks, and invoice your customers for the goods.\n"
"                            Tip: using kits, you can add multiple products at once.\n"
"                        </p><p>\n"
"                            When your task is marked as done, your stock will be updated automatically. Simply choose a warehouse\n"
"                            in your profile from where to draw stock.\n"
"                        </p>"
msgstr ""
"<p class=\"o_view_nocontent_smiling_face\">\n"
"                            محصولی یافت نشد. بیایید یک محصول جدید ایجاد کنیم!\n"
"                        </p><p>\n"
"                            محصولاتی را که برای تکمیل وظایف خود استفاده می‌کنید ردیابی کرده و برای مشتری فاکتور صادر کنید.\n"
"                            نکته: با استفاده از کیت‌ها می‌توانید چندین محصول را به صورت یکجا اضافه کنید.\n"
"                        </p><p>\n"
"                            هنگامی که وظیفه شما به عنوان انجام‌شده علامت‌گذاری شود، موجودی انبار به‌طور خودکار به‌روزرسانی می‌شود. کافی است انبار مورد نظر برای کسر موجودی را در پروفایل خود تعیین کنید.\n"
"                        </p>"

