#. module: account_followup
#: model:mail.template,body_html:account_followup.demo_followup_email_template_2
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">Dear <t t-out=\"object.name or ''\"/> (<t "
"t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                        <t t-else=\"\">Dear <t t-out=\"object.name or ''\"/>,</t>\n"
"                        <br/>\n"
"                        We are disappointed to see that despite sending a reminder, that your account is now seriously "
"overdue.\n"
"                        <br/>\n"
"                        It is essential that immediate payment is made, otherwise we will have to consider placing a stop "
"on your account which means that we will no longer be able to supply your company with (goods/services). Please, take "
"appropriate measures in order to carry out this payment in the next 8 days.\n"
"                        <br/>\n"
"                        If there is a problem with paying invoice that we are not aware of, do not hesitate to contact our "
"accounting department, so that we can resolve the matter quickly.\n"
"                        <br/>\n"
"                        Details of due payments is printed below.\n"
"                        <br/>\n"
"                        Best Regards,\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <br/>\n"
"                            --\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">جناب آقای/سرکار خانم <t t-out=\"object."
"name or ''\"/> (<t t-out=\"object.commercial_partner_id.name or ''\"/>)،</t>\n"
"                        <t t-else=\"\">جناب آقای/سرکار خانم <t t-out=\"object.name or ''\"/>،</t>\n"
"                        <br/>\n"
"                        متأسفانه با وجود ارسال یادآوری پیشین، حساب شما اکنون وارد وضعیت معوقه شدید شده است.\n"
"                        <br/>\n"
"                        تسویه فوری این مبلغ ضروری است؛ در غیر این صورت، ناچار به تعلیق حساب شما خواهیم بود که به معنای توقف "
"ارائه هرگونه کالا یا خدمات خواهد بود. خواهشمند است تمهیدات لازم جهت تسویه حساب ظرف ۸ روز آینده را مبذول فرمایید.\n"
"                        <br/>\n"
"                        چنانچه در خصوص پرداخت فاکتور مشکلی وجود دارد که ما از آن مطلع نیستیم، لطفاً با واحد حسابداری ما تماس "
"حاصل فرمایید تا در اسرع وقت رسیدگی شود.\n"
"                        <br/>\n"
"                        جزئیات بدهی‌های سررسیدشده در ذیل درج گردیده است.\n"
"                        <br/>\n"
"                        با احترام،\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <br/>\n"
"                            --\n"
"                            <br/>\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: account_followup
#: model:mail.template,body_html:account_followup.email_template_followup_1
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">Dear <t t-out=\"object.name or ''\"/> (<t "
"t-out=\"object.commercial_partner_id.name or ''\"/>),</t>\n"
"                        <t t-else=\"\">Dear <t t-out=\"object.name or ''\"/>,</t>\n"
"                    </p>\n"
"                    <p>\n"
"                        We would like to inform you that your account shows an outstanding balance of <b><t t-"
"out=\"format_amount(object.total_overdue_followup, object.currency_id) or ''\"/></b>.\n"
"                        We kindly ask that you settle this amount within the next <b>8 days</b>.\n"
"                    </p>\n"
"                    <p t-if=\"object._show_pay_now_button()\">\n"
"                        <a t-att-href=\"'/my/invoices/overdue'\" style=\"padding: 8px 12px; font-size: 12px; color: "
"#FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-"
"radius:3px\">Pay now</a>\n"
"                    </p>\n"
"                    <p>\n"
"                        If payment has already been made, please disregard this notice.\n"
"                        For any questions or if you need assistance, feel free to contact our accounting department.\n"
"                    </p>\n"
"                    <p>\n"
"                        We appreciate your cooperation in resolving this matter.\n"
"                    </p>\n"
"                    <p>\n"
"                        Sincerely,\n"
"                    </p>\n"
"                    <p>\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">جناب آقای/سرکار خانم <t t-out=\"object."
"name or ''\"/> (<t t-out=\"object.commercial_partner_id.name or ''\"/>)،</t>\n"
"                        <t t-else=\"\">جناب آقای/سرکار خانم <t t-out=\"object.name or ''\"/>،</t>\n"
"                    </p>\n"
"                    <p>\n"
"                        به استحضار می‌رساند که حساب شما دارای مانده بدهی سررسیدشده به مبلغ <b><t t-"
"out=\"format_amount(object.total_overdue_followup, object.currency_id) or ''\"/></b> می‌باشد.\n"
"                        خواهشمند است ترتیبی اتخاذ فرمایید تا این مبلغ حداکثر ظرف <b>۸ روز آینده</b> تسویه گردد.\n"
"                    </p>\n"
"                    <p t-if=\"object._show_pay_now_button()\">\n"
"                        <a t-att-href=\"'/my/invoices/overdue'\" style=\"padding: 8px 12px; font-size: 12px; color: "
"#FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-"
"radius:3px\">پرداخت آنلاین</a>\n"
"                    </p>\n"
"                    <p>\n"
"                        چنانچه این مبلغ قبلاً پرداخت شده است، لطفاً این پیام را نادیده بگیرید.\n"
"                        در صورت وجود هرگونه سؤال یا نیاز به راهنمایی، می‌توانید با واحد حسابداری ما تماس بگیرید.\n"
"                    </p>\n"
"                    <p>\n"
"                        از همکاری صمیمانه شما سپاسگزاریم.\n"
"                    </p>\n"
"                    <p>\n"
"                        با احترام،\n"
"                    </p>\n"
"                    <p>\n"
"                        <t t-if=\"not is_html_empty(object._get_followup_responsible().signature)\">\n"
"                            <t t-out=\"object._get_followup_responsible().signature\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"object._get_followup_responsible().name\"/>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

