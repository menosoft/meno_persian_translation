#. module: equity
#: model:mail.template,body_html:equity.equity_shareholder_email_template
msgid ""
"<div>\n"
"                    <p> Hello <t t-out=\"ctx.get('holder_name')\"/>,<br/>\n"
"                        You will find your latest transaction and valuations in the following link: <br/>\n"
"                        <a t-attf-href=\"/my/equity?access_token={{ctx.get('equity_access_token')}}\" class=\"btn btn-primary\">Show Equity</a> "
"<br/> <br/>\n"
"                        Best,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mitchell Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p> درود <t t-out=\"ctx.get('holder_name')\"/>،<br/>\n"
"                        آخرین تراکنش و ارزیابی‌های خود را می‌توانید در لینک زیر مشاهده کنید: <br/>\n"
"                        <a t-attf-href=\"/my/equitysecret-190195b0'equity_access_token')}}\" class=\"btn btn-primary\">مشاهده سهام</a> <br/> "
"<br/>\n"
"                        با احترام،\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mehdi Nosrati</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: equity
#: model:mail.template,body_html:equity.equity_ubo_form_email_template
msgid ""
"<div>\n"
"                    <p> Hello <t t-out=\"object.name\"/>,<br/>\n"
"                        Following our legal obligations to identify clients, we need to report natural persons who directly or indirectly\n"
"                        hold or control at least 25% in the capital or voting rights of <b><t t-out=\"user_id.company_id.name\"/></b>. <br/> "
"<br/>\n"
"                        Please fill in the UBO request:<br/>\n"
"                        <a t-attf-href=\"/my/ubo?{{object._get_equity_url_params()}}\" class=\"btn btn-primary\">Fill UBO</a> <br/> <br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mitchell Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p> سلام <t t-out=\"object.name\"/>،<br/>\n"
"                        در راستای تکالیف قانونی خود برای شناسایی مشتریان، لازم است اشخاص حقیقی که به طور مستقیم یا غیرمستقیم حداقل ۲۵ درصد از "
"سرمایه یا حقوق حق رأی <b><t t-out=\"user_id.company_id.name\"/></b> را دارا هستند یا کنترل می‌کنند، گزارش دهیم. <br/> <br/>\n"
"                        لطفاً درخواست ذی‌نفع واقعی (UBO) را تکمیل کنید:<br/>\n"
"                        <a t-attf-href=\"/my/ubo?{{object._get_equity_url_params()}}\" class=\"btn btn-primary\">تکمیل فرم UBO</a> <br/> <br/>\n"
"                        با تشکر،\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mitchell Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

