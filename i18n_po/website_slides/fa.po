"                                مشاهده <strong t-out=\"object.name or ''\">سند</strong></a>\n"
"                        </div>\n"
"                        <t t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"                            <br/>\n"
"                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\" data-o-mail-quote=\"1\">میچل ادمین</t></div>\n"
"                        </t>\n"
"                    \n"
"                </div> "

